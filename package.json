{
  "name": "isp-admin-ui-kit",
  "version": "1.9.12",
  "description": "react ui lib for admin-panels",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./admin": {
      "types": "./dist/entries/admin.d.ts",
      "import": "./dist/esm/admin.js",
      "require": "./dist/cjs/admin.js"
    },
    "./utils": {
      "types": "./dist/entries/utils.d.ts",
      "import": "./dist/esm/utils.js",
      "require": "./dist/cjs/utils.js"
    },
    "./hooks": {
      "types": "./dist/entries/hooks.d.ts",
      "import": "./dist/esm/hooks.js",
      "require": "./dist/cjs/hooks.js"
    }
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "rollup -c && tsc-alias -p tsconfig.json",
    "build:prod": "BUILD_SOURCEMAP=false rollup -c && tsc-alias -p tsconfig.json",
    "watch": "rollup -c -w",
    "prepare": "husky  || true",
    "pub": "npm run build:prod && npm publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "url": "https://github.com/txix-open/isp-admin-ui-kit"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@rjsf/antd": "^6.6.2",
    "@rjsf/core": "^6.6.2",
    "@rjsf/validator-ajv8": "^6.6.2",
    "clipboard": "^2.0.11",
    "compare-versions": "^6.1.1",
    "json-schema-view-js": "^2.0.1",
    "lodash.clonedeep": "^4.5.0",
    "mermaid": "^11.15.0",
    "react-resizable": "^4.0.1",
    "simplebar": "^6.3.3",
    "simplebar-react": "^3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/react-vite": "^10.4.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-resizable": "^3.0.8",
    "@types/react-router-dom": "^5.3.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "remark-gfm": "^4.0.1",
    "rollup": "^4.61.1",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.100.0",
    "storybook": "^10.4.3",
    "terser": "^5.48.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.2.5",
    "@dagrejs/dagre": "^3.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "antd": ">=6.0.0",
    "axios": "^1.17.0",
    "dayjs": "^1.11.21",
    "isp-ui-kit": "^2.1.0",
    "monaco-editor": "^0.55.1",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19",
    "react-hook-form": "^7.78.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.4",
    "reactflow": "^11.11.4",
    "redoc": "^2.5.3",
    "yaml": "^2.9.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  }
}
